{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": ".vercel/output",
    "rootDir": ".",
    "moduleResolution": "node",
    "sourceMap": false
  },
  "include": ["api/**/*.ts"],
  "exclude": ["node_modules"]
}
